generator client {
  provider             = "prisma-client-py"
  interface            = "sync"
  recursive_type_depth = "5"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Transaccion {
  id      Int    @id @default(autoincrement())
  codigo  String @unique
  tipo    String
  monto   Int
  impacto Float
}

model Usuario {
  id       Int    @id @default(autoincrement())
  nombre   String
  correo   String @unique
  password String
}
